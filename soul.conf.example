# soul.conf -- generated by tools/example.tcl. Every option is optional.

[soul]
# Let the personality live in this channel (bool, per channel)
#active = no
# How kind and forgiving it is (int)
#agreeableness = 65
# Answer in the language people are speaking (detected per line, remembered per person and channel) (bool, per channel)
#autolang = yes
# Set AWAY while asleep (bool)
#away = no
# Run soul at all (no = loaded but asleep, no binds) (bool)
#enabled = yes
# How much it seeks conversation (int)
#extraversion = 60
# Maximum stored facts (int)
#facts_max = 500
# How much it jokes and laughs along (int)
#humor = 60
# Silence before it considers small talk (duration, per channel)
#idle_after = 20m
# Nicks never answered (network services, other bots) (list)
#ignore_nicks = Q L S D
# Default language (en is the master pack and the fallback) (en|es|fr|pt|de|it, per channel)
#lang = en
# Languages it may answer in (empty = every installed pack) (list, per channel)
#langs = 
# Accept facts taught in this channel (bool, per channel)
#learn_facts = yes
# Lowest level written to Eggdrop's log (debug|info|warn|error)
#log_level = info
# Most lines a command answer may put in a channel (int)
#max_pub_lines = 4
# quiet: only answers; social: also reacts and makes small talk; chatty: more of it (quiet|social|chatty, per channel)
#mode = social
# Other names the bot answers to (besides its nick) (list)
#names = soul
# Prefix of the channel command (!soul); empty = no channel command (str)
#prefix = !
# Also chat in private messages (bool)
#private_chat = no
# Random seed (0 = different every start) (int)
#seed = 0
# How long it stays quiet when told to (duration, per channel)
#shush_time = 30m
# Log what it would say instead of speaking (bool, per channel)
#simulate = no
# Hour when it wakes up (same as start = never sleeps) (int)
#sleep_end = 9
# Hour when it gets sleepy (int)
#sleep_start = 3
# Time zone for the daily rhythm (str)
#timezone = Europe/Madrid
# Track aggregated channel topics for small talk (bool, per channel)
#topics = yes
# Occasional typos with self-correction (bool)
#typos = yes
# How long its answers are (int)
#verbosity = 50

# Per-channel values override the ones above:
#[channel #mychannel]
#active = yes
#lang = es

[permissions]
# Change soul's mood, make it speak, reload packs
#soul.admin = m
# Delete any fact
#soul.facts = o
# Make soul be quiet in a channel
#soul.hush = o|o
# Teach soul facts
#soul.teach = -
# See soul's state, decisions and memory
#soul.view = o

[ratelimit]
# soul commands per person
#soul.cmd = 6/30s
# Lines soul may say per channel
#soul.talk = 8/5m
# Replies to one person (stops bot loops)
#soul.user = 4/60s
